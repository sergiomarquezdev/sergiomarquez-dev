---
import { getLocale, homePath, otherLocale, t } from "../i18n/index";

const locale = getLocale(Astro.currentLocale);
const target = otherLocale(locale);
---

<a href={homePath(target)} class="lang-switch" lang={target} hreflang={target}>
  {t(locale, "lang.switch")}
</a>

<style>
  /* Block padding grows the tap target to ~40px; the negative margin keeps the line box */
  .lang-switch {
    display: inline-block;
    padding-block: var(--s-1);
    margin-block: calc(-1 * var(--s-1));
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.6;
  }
</style>
