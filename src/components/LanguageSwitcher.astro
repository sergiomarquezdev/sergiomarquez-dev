---
import { getLocale, homePath, type Locale, t } from "../i18n/index";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const target: Locale = locale === "es" ? "en" : "es";
---

<a href={homePath(target)} class:list={["lang-switch", className]} lang={target} hreflang={target}>
  {t(locale, "lang.switch")}
</a>

<style>
  .lang-switch {
    display: inline-block;
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.6;
  }
</style>
