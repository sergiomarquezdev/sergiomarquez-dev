---
import { getLocale, homePath, otherLocale, t } from "../i18n/index";

const locale = getLocale(Astro.currentLocale);
const target = otherLocale(locale);
---

<a href={homePath(target)} class="lang-switch" lang={target} hreflang={target}>
  {t(locale, "lang.switch")}
</a>

<style>
  .lang-switch {
    display: inline-block;
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.6;
  }
</style>
