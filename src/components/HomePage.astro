---
import type { CvData } from "../data/cv";
import { getLocale } from "../i18n/index";
import About from "./sections/About.astro";
import Experience from "./sections/Experience.astro";
import Intro from "./sections/Intro.astro";
import Projects from "./sections/Projects.astro";

interface Props {
	cv: CvData;
}

const { cv } = Astro.props;
const locale = getLocale(Astro.currentLocale);
---

<Intro cv={cv} locale={locale} />
<About basics={cv.basics} locale={locale} />
<Projects projects={cv.projects} githubUrl={cv.basics.urls.github} locale={locale} />
<Experience experience={cv.experience} certifications={cv.certifications} locale={locale} />
