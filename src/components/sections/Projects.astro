---
import type { CvData } from "../../data/cv";
import { type Locale, t } from "../../i18n/index";

interface Props {
	projects: CvData["projects"];
	githubUrl: string;
	locale: Locale;
}

type Project = CvData["projects"][number];

const { projects, githubUrl, locale } = Astro.props;

// Private repos never link to their code; a public URL still wins
const hrefOf = (project: Project) =>
	project.url ?? (project.private ? undefined : project.github?.[0]);
const displayUrl = (href: string) => href.replace(/^https?:\/\//, "").replace(/\/$/, "");

const featured = projects.find((project) => project.featured) ?? projects[0];
const rest = projects.filter((project) => project !== featured);
const featuredHref = featured ? hrefOf(featured) : undefined;
---

{
  featured && (
    <section class="section" aria-labelledby="projects-title">
      <div class="container grid-12">
        <h2 id="projects-title" class="section__head">{t(locale, "section.projects")}</h2>
        <div class="section__body">
          <article class="featured">
            <h3 class="featured__name">
              {featuredHref ? <a href={featuredHref}>{featured.name}</a> : featured.name}
            </h3>
            <p class="featured__headline">{featured.headline}</p>
            <p class="meta featured__stack">{featured.stack.join(" · ")}</p>
            {featuredHref && (
              <p class="featured__url">
                <a href={featuredHref}>{displayUrl(featuredHref)}</a>
              </p>
            )}
          </article>

          {rest.length > 0 && (
            <ul class="index">
              {rest.map((project) => {
                const href = hrefOf(project);
                return (
                  <li class="index__row">
                    <div class="index__name">
                      <h3 class="index__title">
                        {href ? <a href={href}>{project.name}</a> : project.name}
                      </h3>
                      {project.private === false && (
                        <p class="meta">{t(locale, "projects.openSource")}</p>
                      )}
                    </div>
                    <div class="index__detail">
                      <p>{project.headline}</p>
                      <p class="meta">{project.stack.join(" · ")}</p>
                    </div>
                  </li>
                );
              })}
            </ul>
          )}

          <p class="projects__more">
            <a href={githubUrl}>{t(locale, "projects.more")}</a>
          </p>
        </div>
      </div>
    </section>
  )
}

<style>
  .featured {
    max-width: var(--measure);
    padding-bottom: var(--s-6);
  }

  .featured__name {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: var(--lh-tight);
    color: var(--teal);
  }

  .featured__headline {
    margin-top: var(--s-2);
    font-family: var(--font-serif);
    font-size: var(--step-lede);
    line-height: var(--lh-lede);
  }

  .featured__stack {
    margin-top: var(--s-2);
  }

  .featured__url {
    margin-top: var(--s-1);
    overflow-wrap: anywhere;
  }

  .index__row {
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-3);
    border-top: 1px solid var(--rule);
  }

  .index__title {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: var(--lh-lede);
  }

  .index__detail {
    max-width: var(--measure);
  }

  .index__detail .meta {
    margin-top: var(--s-1);
  }

  .projects__more {
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
    font-weight: 600;
  }

  @media (min-width: 56rem) {
    .index__row {
      grid-template-columns: repeat(9, minmax(0, 1fr));
      column-gap: var(--s-3);
    }

    .index__name {
      grid-column: 1 / 4;
    }

    .index__detail {
      grid-column: 4 / 10;
    }
  }
</style>
