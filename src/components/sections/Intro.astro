---
import { type CvData, getChannelGroups } from "../../data/cv";
import { type Locale, t } from "../../i18n/index";
import EmailLink from "../EmailLink.astro";

interface Props {
	cv: CvData;
	locale: Locale;
}

const { cv, locale } = Astro.props;
const { basics } = cv;
const channelGroups = getChannelGroups(cv);
---

<section class="intro container grid-12" aria-labelledby="intro-name">
  <h1 id="intro-name" class="intro__name display" translate="no">{basics.name}</h1>
  <p class="intro__tagline">{basics.tagline}</p>
  {basics.headline && <p class="intro__statement">{basics.headline}</p>}

  <ul class="contact" role="list" aria-label={t(locale, "intro.contactLabel")}>
    <li class="contact__row contact__row--email">
      <span class="contact__label">{t(locale, "intro.emailLabel")}</span>
      <EmailLink email={basics.email} />
    </li>
    {
      channelGroups.map((group) => (
        <li class="contact__row">
          <span class="contact__label">{t(locale, `intro.group.${group.key}` as const)}</span>
          <div class="contact__value">
            <ul class="contact__links" role="list">
              {group.channels.map((channel) => (
                <li>
                  {/* A lone channel shows its address; grouped ones are named by network */}
                  <a class="contact__link" href={channel.href} translate="no">
                    {group.channels.length === 1 ? channel.handle : channel.label}
                  </a>
                </li>
              ))}
            </ul>
            {group.description && <p class="contact__description">{group.description}</p>}
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .intro {
    padding-top: var(--s-6);
  }

  .intro__tagline {
    margin-top: var(--s-2);
    color: var(--ink-2);
  }

  .intro__statement {
    margin-top: var(--s-6);
    max-width: 18em;
    font-family: var(--font-serif);
    font-size: var(--step-statement);
    line-height: var(--lh-tight);
    text-wrap: balance;
  }

  .contact {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-6);
  }

  .contact__row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: baseline;
  }

  .contact__row--email {
    padding-bottom: var(--s-1);
  }

  /* Narrow screens: the email takes the full row under its label */
  @media (max-width: 35.99rem) {
    .contact__row--email {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .contact__label {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
  }

  .contact__row--email :global(a) {
    display: inline-block;
    font-size: var(--step-1);
    font-weight: 600;
    line-height: var(--lh-lede);
    color: var(--teal);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    overflow-wrap: anywhere;
  }

  .contact__row--email :global(a:focus-visible) {
    color: var(--accent);
  }

  @media (hover: hover) {
    .contact__row--email :global(a:hover) {
      color: var(--accent);
    }
  }

  .contact__row--email :global(a:active) {
    color: var(--accent-strong);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-3);
  }

  .contact__link {
    display: inline-block;
    overflow-wrap: anywhere;
  }

  .contact__description {
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-2);
  }

  @media (min-width: 56rem) {
    /* The card is as tall as its content: forcing it to the viewport left a
       band of empty paper once the contact block became four rows */
    .intro {
      grid-template-rows: auto auto auto auto;
      padding-top: var(--s-4);
    }

    /* The card edge: a 1px rule closes the front across the twelve columns */
    .intro::after {
      content: "";
      grid-column: 1 / 13;
      grid-row: 4;
      margin-top: var(--s-6);
      border-top: 1px solid var(--rule);
    }

    .intro__name,
    .intro__tagline,
    .intro__statement {
      grid-column: 1 / 13;
    }

    .intro__tagline {
      grid-column: 1 / 9;
    }

    /* Statement and contact share the card's bottom edge, on the rule */
    .intro__statement {
      grid-column: 1 / 7;
      grid-row: 3;
      align-self: end;
    }

    .contact {
      grid-column: 7 / 13;
      grid-row: 3;
      align-self: end;
    }
  }
</style>
