---
import { type CvData, groupByCompany } from "../../data/cv";
import { formatDate, type Locale, t } from "../../i18n/index";

interface Props {
	experience: CvData["experience"];
	certifications: CvData["certifications"];
	locale: Locale;
}

const { experience, certifications, locale } = Astro.props;
const groups = groupByCompany(experience);

// The current role shows its strongest highlights; the rest fold like past roles
const VISIBLE_HIGHLIGHTS = 4;
---

{
  experience.length > 0 && (
    <section class="section" aria-labelledby="experience-title">
      <div class="container grid-12">
        <h2 id="experience-title" class="section__head">{t(locale, "section.experience")}</h2>
        <div class="section__body">
          {groups.map((group) => (
            <div class="company">
              <h3 class="company__name" translate="no">{group.company}</h3>
              {group.roles.map((role) => {
                const stack = role.stack && role.stack.length > 0 && (
                  <p class="meta role__stack">
                    <span class="role__stack-label">{t(locale, "experience.stack")}</span>{" "}
                    {role.stack.join(" · ")}
                  </p>
                );
                const list = (items: string[]) =>
                  items.length > 0 && (
                    <ul class="role__highlights">
                      {items.map((item) => <li>{item}</li>)}
                    </ul>
                  );
                const shown = role.current ? role.highlights.slice(0, VISIBLE_HIGHLIGHTS) : [];
                const folded = role.current ? role.highlights.slice(VISIBLE_HIGHLIGHTS) : role.highlights;
                const summary = role.current ? t(locale, "experience.more") : t(locale, "experience.details");
                return (
                  <article class:list={["role", { "role--current": role.current }]}>
                    <div class="role__head">
                      <h4 class="role__title">{role.role}</h4>
                      <p class="meta role__period tabular">{role.period}</p>
                    </div>
                    <p class="role__headline">{role.headline ?? role.summary}</p>
                    {list(shown)}
                    {(folded.length > 0 || stack) && (
                      <details class="role__details">
                        <summary>
                          {summary}
                          <span class="visually-hidden">: {role.role}</span>
                        </summary>
                        {list(folded)}
                        {stack}
                      </details>
                    )}
                  </article>
                );
              })}
            </div>
          ))}

          {certifications.length > 0 && (
            <div class="certs">
              <h3 class="certs__title">{t(locale, "section.certifications")}</h3>
              <ul class="certs__list" role="list">
                {certifications.map((cert) => (
                  <li>
                    {cert.url ? <a href={cert.url}>{cert.name}</a> : cert.name}
                    <span class="certs__meta">
                      {" · "}
                      {cert.issuer}
                      {" · "}
                      <time class="tabular" datetime={cert.date}>
                        {formatDate(cert.date, locale)}
                      </time>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .company__name {
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--ink-2);
  }

  /* Rules and role rows run to the right edge of the column like the project
     index; only running text keeps the measure */
  .role {
    padding-block: var(--s-3);
    border-top: 1px solid var(--rule);
  }

  .company__name + .role {
    margin-top: var(--s-2);
  }

  .role__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: var(--s-3);
  }

  .role__title {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: var(--lh-lede);
  }

  .role--current .role__title {
    color: var(--teal);
  }

  .role__headline,
  .role__highlights,
  .role__stack {
    max-width: var(--measure);
  }

  .role__headline {
    margin-top: var(--s-1);
    color: var(--ink-2);
  }

  .role--current .role__headline {
    color: var(--ink);
  }

  .role__highlights {
    display: grid;
    gap: var(--s-1);
    margin-top: var(--s-2);
    padding-left: var(--s-3);
    list-style: "– ";
  }

  .role__highlights li::marker {
    color: var(--teal);
  }

  .role__stack {
    margin-top: var(--s-2);
  }

  .role__stack-label {
    font-weight: 600;
  }

  .role__details {
    margin-top: var(--s-1);
  }

  /* Padding makes the disclosure a comfortable tap target without moving text */
  .role__details summary {
    display: list-item;
    width: fit-content;
    padding-block: var(--s-1);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .role__details summary::marker {
    color: var(--teal);
  }

  .role__details summary:focus-visible {
    color: var(--accent);
  }

  .role__details summary:active {
    color: var(--accent-strong);
  }

  @media (hover: hover) {
    .role__details summary:hover {
      color: var(--accent);
    }
  }

  .certs {
    margin-top: var(--s-6);
  }

  .certs__title {
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--ink-2);
  }

  .certs__list {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-2);
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
  }

  .certs__meta {
    color: var(--ink-2);
  }

  @media (max-width: 55.99rem) {
    .role__head {
      flex-direction: column;
    }
  }
</style>
