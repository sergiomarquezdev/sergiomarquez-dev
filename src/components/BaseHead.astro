---
import { getCv } from "../data/cv";
import { getLocale, homePath, otherLocale, t } from "../i18n/index";

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const cv = getCv(locale);
// `site` is set in astro.config.mjs, so every absolute URL resolves against it
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL("/og-image.png", Astro.site);
const currentRole = cv.experience[0];

const person = {
	"@type": "Person",
	name: cv.basics.name,
	jobTitle: currentRole?.role,
	description: cv.basics.summary,
	url: cv.basics.urls.site,
	email: cv.basics.email,
	sameAs: [
		cv.basics.urls.github,
		cv.basics.urls.linkedin,
		cv.basics.urls.x,
		cv.basics.urls.youtube,
		cv.basics.urls.tiktok,
		cv.basics.urls.blog,
	].filter(Boolean),
	worksFor: currentRole && {
		"@type": "Organization",
		name: currentRole.company,
	},
	knowsAbout: t(locale, "structured.knowsAbout").split(","),
};

const structuredData = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	url: canonicalURL.href,
	inLanguage: locale,
	image: socialImageURL.href,
	mainEntity: person,
};
---

<meta charset='UTF-8' />
<link rel='preload' href='/fonts/space-grotesk-latin-wght-normal-v5.3.0.woff2' as='font' type='font/woff2' crossorigin />
<link rel='preload' href='/fonts/instrument-serif-latin-400-normal-v5.3.0.woff2' as='font' type='font/woff2' crossorigin />
<meta name='description' content={description} />
<meta name='viewport' content='width=device-width, initial-scale=1' />
<meta name='color-scheme' content='light dark' />
<meta name='theme-color' content='#fafaf9' media='(prefers-color-scheme: light)' />
<meta name='theme-color' content='#0c0a09' media='(prefers-color-scheme: dark)' />
<meta name='robots' content={noindex ? "noindex" : "index, follow"} />
<meta name='author' content='Sergio Márquez' />
<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
<link rel='icon' type='image/x-icon' href='/favicon.ico' />
<link rel='apple-touch-icon' href='/apple-touch-icon.png' />
<link rel='manifest' href='/manifest.webmanifest' />
<meta name='generator' content={Astro.generator} />

{
	!noindex && (
		<Fragment>
			<link rel='canonical' href={canonicalURL} />
			<link rel='alternate' hreflang='es' href={new URL(homePath("es"), Astro.site)} />
			<link rel='alternate' hreflang='en' href={new URL(homePath("en"), Astro.site)} />
			<link rel='alternate' hreflang='x-default' href={new URL(homePath("es"), Astro.site)} />
		</Fragment>
	)
}

<title>{title}</title>

<!-- Open Graph / Facebook -->
<meta property='og:type' content='website' />
{!noindex && <meta property='og:url' content={canonicalURL} />}
<meta property='og:title' content={title} />
<meta property='og:description' content={description} />
<meta property='og:image' content={socialImageURL} />
<meta property='og:image:type' content='image/png' />
<meta property='og:image:width' content='1200' />
<meta property='og:image:height' content='630' />
<meta property='og:image:alt' content={t(locale, "og.imageAlt")} />
<meta property='og:locale' content={t(locale, "og.locale")} />
<meta property='og:locale:alternate' content={t(otherLocale(locale), "og.locale")} />
<meta property='og:site_name' content='Sergio Márquez' />

<!-- Twitter -->
<meta name='twitter:card' content='summary_large_image' />
{!noindex && <meta name='twitter:url' content={canonicalURL} />}
<meta name='twitter:title' content={title} />
<meta name='twitter:description' content={description} />
<meta name='twitter:image' content={socialImageURL} />
<meta name='twitter:creator' content='@sergiomarquezp_' />

<!-- Structured Data -->
{
	!noindex && (
		<script type='application/ld+json' is:inline set:html={JSON.stringify(structuredData)} />
	)
}
