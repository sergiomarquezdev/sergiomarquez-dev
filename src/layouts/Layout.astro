---
import BaseHead from "../components/BaseHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getLocale, t } from "../i18n/index";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	/** Error pages: robots noindex, no canonical, hreflang or JSON-LD */
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const locale = getLocale(Astro.currentLocale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <a href="#main" class="skip-link">{t(locale, "skip.main")}</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <style>
      .skip-link {
        position: absolute;
        top: var(--s-1);
        left: var(--s-1);
        z-index: 1;
        padding: var(--s-1) var(--s-2);
        background: var(--paper);
        color: var(--teal);
        font-weight: 600;
        transform: translateY(-200%);
      }

      .skip-link:focus {
        transform: none;
      }
    </style>
  </body>
</html>
