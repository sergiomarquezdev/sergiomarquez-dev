---
// Cloudflare Pages serves this single 404.html for every unknown path in
// both languages, so the page carries both messages statically.
import { getCv } from "../data/cv";
import { homePath, locales, t } from "../i18n/index";
import Layout from "../layouts/Layout.astro";

const { basics } = getCv("es");
const title = `404 · ${basics.name}`;
const description = locales.map((locale) => t(locale, "notFound.description")).join(" ");
---

<Layout title={title} description={description} noindex>
  <section class="not-found container" aria-labelledby="not-found-title">
    <h1 id="not-found-title" class="not-found__code display">
      404<span class="visually-hidden"> · {t("es", "notFound.description")}</span>
    </h1>
    {
      locales.map((locale) => (
        <div class="not-found__block" lang={locale}>
          <p class="not-found__message">{t(locale, "notFound.message")}</p>
          <p class="not-found__cta">
            <a href={homePath(locale)}>{t(locale, "notFound.cta")}</a>
          </p>
        </div>
      ))
    }
  </section>
</Layout>

<style>
  .not-found {
    padding-top: var(--s-6);
  }

  .not-found__block {
    max-width: var(--measure);
    margin-top: var(--s-6);
  }

  .not-found__block + .not-found__block {
    margin-top: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  /* Both languages side by side: the bilingual page reads as one card */
  @media (min-width: 56rem) {
    .not-found {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s-6);
    }

    .not-found__code {
      grid-column: 1 / -1;
    }

    .not-found__block + .not-found__block {
      margin-top: var(--s-6);
      padding-top: 0;
      border-top: 0;
    }
  }

  .not-found__message {
    font-family: var(--font-serif);
    font-size: var(--step-lede);
    line-height: var(--lh-lede);
  }

  .not-found__cta {
    margin-top: var(--s-1);
    font-weight: 600;
  }
</style>
